{
  "name": "opencode-attention-plus",
  "version": "0.1.1",
  "license": "MIT",
  "description": "OpenCode TUI plugin for delayed question, permission, completion, and error notifications",
  "repository": { "type": "git", "url": "git+https://github.com/ex10se/opencode-attention-plus.git" },
  "bugs": { "url": "https://github.com/ex10se/opencode-attention-plus/issues" },
  "homepage": "https://github.com/ex10se/opencode-attention-plus#readme",
  "keywords": ["opencode", "plugin", "notifications", "macos"],
  "type": "module",
  "exports": { "./tui": { "types": "./dist/tui.d.ts", "import": "./dist/tui.js" } },
  "files": ["dist", "LICENSE", "README.md", "README.ru.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "docs"],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": { "@opencode/plugin": "2.2.5" },
  "peerDependencies": { "solid-js": "^1.9.17" },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "22.19.0" }
}
